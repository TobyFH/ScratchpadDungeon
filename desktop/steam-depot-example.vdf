// Replace placeholders in your Steamworks partner workspace. Never commit credentials.
"AppBuild"
{
  "AppID" "YOUR_APP_ID"
  "Desc" "Scratchpad Dungeon production candidate"
  "BuildOutput" "../steam-build-logs"
  "ContentRoot" "../dist/desktop/linux-unpacked"
  "SetLive" "" // Upload for review; choose a beta branch manually in Steamworks.
  "Depots"
  {
    "YOUR_LINUX_DEPOT_ID" { "FileMapping" { "LocalPath" "*" "DepotPath" "." "recursive" "1" } }
  }
}
